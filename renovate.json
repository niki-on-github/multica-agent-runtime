{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests",
    "helpers:pinGitHubActionDigestsToSemver"
  ],
  "dependencyDashboard": true,
  "dependencyDashboardTitle": "Renovate Dashboard",
  "dependencyDashboardApproval": false,
  "labels": [
    "renovatebot"
  ],
  "minimumReleaseAge": "0 days",
  "prHourlyLimit": 0,
  "prConcurrentLimit": 0,
  "branchConcurrentLimit": 0,
  "automerge": true,
  "automergeType": "pr",
  "ignoreTests": true,
  "customDatasources": {
    "chrome-for-testing": {
      "defaultRegistryUrlTemplate": "https://googlechromelabs.github.io/chrome-for-testing/last-known-good-versions.json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": channels.Stable.version}]}"
      ]
    }
  },
  "customManagers": [
    {
      "description": "ARG <NAME>_VERSION with a `# renovate: datasource=... depName=...` comment above it",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( registryUrl=(?<registryUrl>\\S+))?( extractVersion=(?<extractVersion>\\S+))?( versioning=(?<versioning>\\S+))?\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)"
      ]
    },
    {
      "description": "GitHub release binaries: version and sha256 of the release attachment",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)Dockerfile$/"
      ],
      "matchStrings": [
        "# renovate-digest: depName=(?<depName>\\S+)\\s+ARG \\w+_VERSION=(?<currentValue>\\S+)\\s+ARG \\w+_SHA256=(?<currentDigest>[a-f0-9]{64})"
      ],
      "datasourceTemplate": "github-release-attachments"
    }
  ],
  "platformAutomerge": true,
  "separateMajorMinor": false,
  "separateMultipleMajor": false,
  "separateMinorPatch": false,
  "packageRules": [
    {
      "description": "Every update (base images, Multica, agent CLIs, Chrome, Docker, NVIDIA, binaries, actions, majors included) in one PR, merged right away: one build per batch; CI on main runs the smoke tests before anything is published",
      "matchPackageNames": [
        "*"
      ],
      "groupName": "all dependencies",
      "groupSlug": "all",
      "automerge": true,
      "dependencyDashboardApproval": false
    }
  ]
}
