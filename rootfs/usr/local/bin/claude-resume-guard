#!/usr/bin/env python3
"""claude-resume-guard [claude args...]: avoid an expensive cold `claude --resume`.

The Multica daemon continues an issue with `claude -p ... --resume <session id>`. When the prompt cache of
that session has expired (after a 5-hour limit, a night, ...) the first request has to read the whole
conversation uncached, which for a session near 1M context costs a large part of a plan window.

The entrypoint points MULTICA_CLAUDE_PATH at a shim that execs this script (CLAUDE_RESUME_GUARD, default
`summarize`). It looks at the transcript the daemon asks to resume:

  * no --resume, no MULTICA_TASK_ID, transcript missing, warm (idle < IDLE_MINUTES) or small
    (< MIN_TOKENS): exec the next command unchanged
  * cold and big: build a digest of the transcript (user messages, assistant text, files touched; no tool
    results), turn it into a hand-off (summarize: a small model, default haiku; digest: the digest itself),
    drop `--resume <id>` and pass the hand-off with --append-system-prompt-file, so Claude starts a fresh
    session that knows the earlier work. The old transcript is left untouched.

Failures never block the task: if the summary call hits a usage/rate limit the run resumes unchanged (a
resume fails the same way and the daemon keeps its session pointer); other summary failures fall back to the
digest (CLAUDE_RESUME_GUARD_FALLBACK=digest) or to the unchanged resume (=resume); any internal error
resumes unchanged. If the guarded fresh run fails before using a tool the daemon retries the task without
--resume; the hand-off is kept per MULTICA_TASK_ID so that retry gets it too.

Environment (all optional):
  CLAUDE_RESUME_GUARD               summarize (default) | digest | off
  CLAUDE_RESUME_GUARD_NEXT          command to exec (default: `claude` on PATH, not this guard)
  CLAUDE_RESUME_GUARD_IDLE_MINUTES  idle time after which the cache counts as cold (default 30)
  CLAUDE_RESUME_GUARD_MIN_TOKENS    context size from which a cold resume is replaced (default 150000)
  CLAUDE_RESUME_GUARD_MODEL         model of the summary call (default haiku)
  CLAUDE_RESUME_GUARD_TIMEOUT       seconds for the summary call (default 50: the daemon waits 60 s for
                                    Claude's initialize handshake, which only starts after the guard)
  CLAUDE_RESUME_GUARD_DIGEST_TOKENS size of the digest sent to the summary model (default 60000)
  CLAUDE_RESUME_GUARD_HANDOFF_TOKENS size of a digest used directly as hand-off (default 20000)
  CLAUDE_RESUME_GUARD_FALLBACK      digest (default) | resume: what a failed summary call falls back to
  CLAUDE_RESUME_GUARD_STATE_DIR     event log and per-task hand-offs (default ~/.local/state/claude-resume-guard)
"""

from __future__ import annotations

import datetime as dt
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

GUARD_DIR = "/usr/local/lib/multica-agent-runtime/guard-bin"
CHARS_PER_TOKEN = 4
PENDING_MAX_AGE = 24 * 3600
FILE_TOOLS = {"Edit", "Write", "MultiEdit", "NotebookEdit"}
LIMIT_RE = re.compile(
    r"usage limit|rate.?limit|limit reached|hit your limit|out of (extra )?usage|quota|overloaded|\b429\b|\b529\b",
    re.IGNORECASE,
)

SUMMARY_INSTRUCTIONS = """\
You write the hand-off note between two sessions of a coding agent. Below is an extract of the earlier
session's transcript (user messages, the agent's replies, the tools it used and the files it changed; tool
outputs are left out). A fresh session of the same agent continues the work with only your note and the
repository, so it must not need the transcript.

Write the note in Markdown, at most about 1500 words, with these sections:
1. Task: what the user wants, including constraints, preferences and decisions they stated (quote exact
   requirements).
2. Done so far: what was implemented, changed, committed or pushed (branches, PRs, commits if named), and what
   was tried and rejected, with the reason.
3. Current state: where the work stopped, what is in progress, failing tests or errors still open.
4. Files: the important files and what they hold or what changed in them.
5. Open items and next steps: what remains, questions the user has not answered, the next concrete step.

Only state what the extract supports; say "unclear" rather than guessing. No preamble, start with the first
heading.

<transcript-extract>
"""


def env_int(name: str, default: int) -> int:
    try:
        return int(os.environ.get(name, "") or default)
    except ValueError:
        return default


def log(msg: str) -> None:
    # one line in the task's stderr (the daemon log); avoid the daemon's resume-rejection phrases
    print(f"claude-resume-guard: {msg}", file=sys.stderr, flush=True)


def state_dir() -> str:
    d = os.environ.get("CLAUDE_RESUME_GUARD_STATE_DIR") or os.path.join(
        os.environ.get("XDG_STATE_HOME") or os.path.join(os.path.expanduser("~"), ".local", "state"),
        "claude-resume-guard",
    )
    return d


def record(event: dict) -> None:
    try:
        d = state_dir()
        os.makedirs(d, exist_ok=True)
        event = {"time": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"), **event}
        with open(os.path.join(d, "events.jsonl"), "a", encoding="utf-8") as f:
            f.write(json.dumps(event, ensure_ascii=False) + "\n")
    except OSError:
        pass


# --- next command --------------------------------------------------------------------------------
def next_command() -> list[str]:
    nxt = os.environ.get("CLAUDE_RESUME_GUARD_NEXT", "")
    if nxt:
        return [nxt]
    me = os.path.realpath(__file__)
    for d in os.environ.get("PATH", "").split(os.pathsep):
        if not d or os.path.realpath(d) == os.path.realpath(GUARD_DIR):
            continue
        p = os.path.join(d, "claude")
        if os.path.isfile(p) and os.access(p, os.X_OK) and os.path.realpath(p) != me:
            return [p]
    sys.exit("claude-resume-guard: claude not found on PATH")


def run_next(cmd: list[str], args: list[str]) -> None:
    sys.stdout.flush()
    sys.stderr.flush()
    os.execv(cmd[0], cmd + args)


# --- arguments -----------------------------------------------------------------------------------
def find_resume(args: list[str]) -> tuple[str, int, int] | None:
    """(session id, start index, count of args) of --resume/-r <id> or --resume=<id>."""
    for i, a in enumerate(args):
        if a in ("--resume", "-r") and i + 1 < len(args) and not args[i + 1].startswith("-"):
            return args[i + 1], i, 2
        if a.startswith("--resume="):
            return a.split("=", 1)[1], i, 1
    return None


def with_handoff(args: list[str], handoff_path: str) -> list[str]:
    """args plus --append-system-prompt-file; merges an existing one (a CLI takes the flag once)."""
    out = list(args)
    for i, a in enumerate(out):
        existing = None
        if a == "--append-system-prompt-file" and i + 1 < len(out):
            existing, j = out[i + 1], i + 1
        elif a.startswith("--append-system-prompt-file="):
            existing, j = a.split("=", 1)[1], i
        if existing is not None:
            try:
                with open(existing, encoding="utf-8") as src, open(handoff_path, "r+", encoding="utf-8") as dst:
                    ours = dst.read()
                    dst.seek(0)
                    dst.write(src.read().rstrip() + "\n\n" + ours)
                    dst.truncate()
            except OSError:
                pass
            out[j] = handoff_path if j == i + 1 else "--append-system-prompt-file=" + handoff_path
            return out
    return out + ["--append-system-prompt-file", handoff_path]


# --- transcript ----------------------------------------------------------------------------------
def encode_cwd(cwd: str) -> str:
    # Claude Code's projects/<encoded cwd> (Multica: encodeClaudeCwd)
    return re.sub(r"[^A-Za-z0-9]", "-", cwd)


def transcript_path(session_id: str) -> str | None:
    if not re.fullmatch(r"[A-Za-z0-9._-]{1,128}", session_id):
        return None
    config = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
    p = os.path.join(config, "projects", encode_cwd(os.getcwd()), session_id + ".jsonl")
    if os.path.isfile(p):
        return p
    p2 = os.path.join(config, "projects", encode_cwd(os.path.realpath(os.getcwd())), session_id + ".jsonl")
    return p2 if os.path.isfile(p2) else None


def parse_time(value: str) -> float | None:
    try:
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
    except (ValueError, AttributeError):
        return None


def load(path: str) -> list[dict]:
    entries = []
    with open(path, "rb") as f:
        for raw in f:
            try:
                e = json.loads(raw)
            except ValueError:
                continue
            if isinstance(e, dict):
                e["_bytes"] = len(raw)
                entries.append(e)
    return entries


def measure(entries: list[dict], fallback_mtime: float) -> tuple[int, float]:
    """(context tokens of the next request, last activity as epoch seconds)."""
    last_ts = None
    last_usage_idx = -1
    usage_tokens = 0
    boundary_idx = -1
    for i, e in enumerate(entries):
        t = parse_time(e.get("timestamp", "")) if e.get("timestamp") else None
        if t is not None:
            last_ts = t if last_ts is None else max(last_ts, t)
        if e.get("isSidechain"):
            continue
        if e.get("type") == "system" and e.get("subtype") == "compact_boundary":
            boundary_idx = i
        msg = e.get("message")
        if e.get("type") == "assistant" and isinstance(msg, dict) and isinstance(msg.get("usage"), dict):
            u = msg["usage"]
            total = sum(int(u.get(k) or 0) for k in
                        ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens", "output_tokens"))
            if total > 0:
                usage_tokens, last_usage_idx = total, i
    if last_usage_idx < boundary_idx or last_usage_idx < 0:
        # compacted after the last measured request (or never measured): estimate from the size
        start = boundary_idx + 1 if boundary_idx >= 0 else 0
        usage_tokens = sum(e["_bytes"] for e in entries[start:] if not e.get("isSidechain")) // CHARS_PER_TOKEN
    return usage_tokens, last_ts if last_ts is not None else fallback_mtime


def clip(text: str, limit: int) -> str:
    text = text.strip()
    if len(text) <= limit:
        return text
    head = limit * 2 // 3
    return text[:head] + f"\n[... {len(text) - limit} characters cut ...]\n" + text[-(limit - head):]


def tool_line(block: dict) -> str:
    name = block.get("name", "?")
    inp = block.get("input") if isinstance(block.get("input"), dict) else {}
    for key in ("file_path", "notebook_path", "path", "command", "pattern", "url", "description", "prompt"):
        if inp.get(key):
            return f"[tool {name}: {clip(str(inp[key]).replace(chr(10), ' '), 200)}]"
    return f"[tool {name}]"


def digest(entries: list[dict], budget_chars: int) -> str:
    """A text extract of the main conversation that fits budget_chars."""
    boundary_idx = -1
    for i, e in enumerate(entries):
        if not e.get("isSidechain") and e.get("type") == "system" and e.get("subtype") == "compact_boundary":
            boundary_idx = i
    first_user = None
    compact_summary = None
    items: list[str] = []
    files: list[str] = []
    for i, e in enumerate(entries):
        if e.get("isSidechain") or e.get("type") not in ("user", "assistant"):
            continue
        msg = e.get("message")
        if not isinstance(msg, dict):
            continue
        content = msg.get("content")
        blocks = [{"type": "text", "text": content}] if isinstance(content, str) else content
        if not isinstance(blocks, list):
            continue
        parts = []
        for b in blocks:
            if not isinstance(b, dict):
                continue
            if b.get("type") == "text" and b.get("text", "").strip():
                parts.append(b["text"])
            elif b.get("type") == "tool_use":
                if e["type"] == "assistant":
                    parts.append(tool_line(b))
                    inp = b.get("input") if isinstance(b.get("input"), dict) else {}
                    fp = inp.get("file_path") or inp.get("notebook_path")
                    if b.get("name") in FILE_TOOLS and fp and fp not in files:
                        files.append(fp)
        if not parts:
            continue
        text = "\n".join(parts)
        if e["type"] == "user":
            if e.get("isCompactSummary"):
                compact_summary = clip(text, 40000)  # the latest one wins
                continue
            if e.get("isMeta"):
                continue
            if first_user is None:
                first_user = clip(text, 12000)
                continue
            if i < boundary_idx:
                continue
            items.append("## User\n" + clip(text, 6000))
        else:
            if i < boundary_idx:
                continue
            items.append("## Agent\n" + clip(text, 4000))

    head = []
    if first_user:
        head.append("## First user message (the task)\n" + first_user)
    if compact_summary:
        head.append("## Summary of the conversation before its last compaction\n" + compact_summary)
    tail = []
    if files:
        tail.append("## Files edited or written\n" + "\n".join(f"- {f}" for f in files[-200:]))
    used = sum(len(x) + 2 for x in head + tail)
    kept: list[str] = []
    for item in reversed(items):
        if used + len(item) + 2 > budget_chars:
            break
        kept.append(item)
        used += len(item) + 2
    kept.reverse()
    omitted = len(items) - len(kept)
    body = head + ([f"[... {omitted} earlier messages omitted ...]"] if omitted else []) + kept + tail
    return clip("\n\n".join(body), budget_chars)


# --- summary call --------------------------------------------------------------------------------
def summarize(cmd: list[str], text: str) -> tuple[str | None, str]:
    """(hand-off, reason). reason is 'ok', 'limit' or a short error."""
    model = os.environ.get("CLAUDE_RESUME_GUARD_MODEL", "haiku")
    timeout = env_int("CLAUDE_RESUME_GUARD_TIMEOUT", 50)
    base = os.environ.get("TMPDIR") or tempfile.gettempdir()
    try:
        work = tempfile.mkdtemp(prefix="claude-resume-guard-", dir=base)
    except OSError:
        work = tempfile.mkdtemp(prefix="claude-resume-guard-")
    args = ["-p", "--model", model, "--output-format", "json", "--no-session-persistence", "--max-turns", "1",
            "--tools", "", "--strict-mcp-config", "--disable-slash-commands",
            "--settings", '{"disableAllHooks":true}']
    env = dict(os.environ)
    env.pop("CLAUDE_CODE_AUTO_COMPACT_WINDOW", None)
    try:
        p = subprocess.run(cmd + args, input=(SUMMARY_INSTRUCTIONS + text + "\n</transcript-extract>\n").encode(),
                           capture_output=True, timeout=timeout, cwd=work, env=env)
    except subprocess.TimeoutExpired:
        return None, f"timeout after {timeout}s"
    except OSError as e:
        return None, f"cannot start: {e}"
    finally:
        shutil.rmtree(work, ignore_errors=True)
        # the empty projects/<cwd> dir Claude (or the sandbox) made for the temp dir
        config = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
        try:
            os.rmdir(os.path.join(config, "projects", encode_cwd(work)))
        except OSError:
            pass
    out = p.stdout.decode(errors="replace")
    err = p.stderr.decode(errors="replace")
    result = None
    for line in reversed(out.strip().splitlines()):
        try:
            obj = json.loads(line)
        except ValueError:
            continue
        if isinstance(obj, dict) and obj.get("type") == "result":
            result = obj
            break
    if result is None:
        if LIMIT_RE.search(out + err):
            return None, "limit"
        return None, f"exit {p.returncode}: {clip((err or out).strip(), 300) or 'no result'}"
    text_out = str(result.get("result") or "")
    if result.get("is_error") or result.get("subtype") != "success":
        if result.get("api_error_status") in (429, 529) or LIMIT_RE.search(text_out + err):
            return None, "limit"
        return None, f"error: {clip(text_out, 300) or result.get('subtype')}"
    if len(text_out.strip()) < 200:
        return None, "summary too short"
    return text_out.strip(), "ok"


def handoff_text(session_id: str, tokens: int, idle_s: float, source: str, body: str) -> str:
    idle = f"{int(idle_s // 3600)}h{int(idle_s % 3600 // 60):02d}m"
    return f"""\
# Session hand-off (claude-resume-guard)

This is a fresh session. It replaces the earlier Claude Code session {session_id} of this task (about
{tokens // 1000}k tokens of context, idle for {idle}): its prompt cache had expired, so resuming it would have
re-read the whole conversation uncached. Below is a hand-off of that session ({source}). Treat it as your
memory of the earlier work; it can be incomplete. If the user message speaks of continuing or resuming,
this hand-off is that earlier context. Before you act: follow the comment-reading steps of your instructions
(the full issue scan, not only the triggering comment), check `git status` and `git log` of the work tree,
and re-read files before you edit them.

<handoff>
{body.strip()}
</handoff>
"""


def write_handoff(text: str) -> str:
    base = os.environ.get("TMPDIR") or tempfile.gettempdir()
    try:
        fd, path = tempfile.mkstemp(prefix="claude-resume-guard-", suffix=".md", dir=base)
    except OSError:
        fd, path = tempfile.mkstemp(prefix="claude-resume-guard-", suffix=".md")
    with os.fdopen(fd, "w", encoding="utf-8") as f:
        f.write(text)
    return path


def pending_path(task_id: str) -> str | None:
    if not re.fullmatch(r"[A-Za-z0-9_-]{1,128}", task_id):
        return None
    return os.path.join(state_dir(), "pending", task_id + ".md")


def clean_pending() -> None:
    d = os.path.join(state_dir(), "pending")
    try:
        now = time.time()
        for name in os.listdir(d):
            p = os.path.join(d, name)
            if now - os.path.getmtime(p) > PENDING_MAX_AGE:
                os.unlink(p)
    except OSError:
        pass


# --- main ----------------------------------------------------------------------------------------
def guard(args: list[str], cmd: list[str]) -> list[str]:
    """The arguments to exec the next command with."""
    mode = os.environ.get("CLAUDE_RESUME_GUARD", "summarize").strip().lower()
    if mode in ("off", "0", "false", "no", ""):
        return args
    if mode not in ("summarize", "digest"):
        mode = "summarize"
    task_id = os.environ.get("MULTICA_TASK_ID", "")
    if not task_id:
        return args  # version/model probes, manual runs
    clean_pending()
    res = find_resume(args)
    if res is None:
        # a fresh run of a task whose guarded run failed early: the daemon retries without --resume
        pp = pending_path(task_id)
        if pp and os.path.isfile(pp):
            path = write_handoff(open(pp, encoding="utf-8").read())
            log(f"task {task_id} retried without a session: passing its hand-off again")
            record({"task": task_id, "action": "retry-handoff"})
            return with_handoff(args, path)
        return args
    session_id, idx, count = res
    path = transcript_path(session_id)
    if path is None:
        return args  # nothing to measure: Claude and the daemon handle a missing transcript
    entries = load(path)
    tokens, last = measure(entries, os.path.getmtime(path))
    idle = max(0.0, time.time() - last)
    idle_limit = env_int("CLAUDE_RESUME_GUARD_IDLE_MINUTES", 30) * 60
    min_tokens = env_int("CLAUDE_RESUME_GUARD_MIN_TOKENS", 150000)
    if idle < idle_limit or tokens < min_tokens:
        return args
    base = {"task": task_id, "session": session_id, "tokens": tokens, "idle_minutes": int(idle // 60)}

    source = None
    body = None
    if mode == "summarize":
        extract = digest(entries, env_int("CLAUDE_RESUME_GUARD_DIGEST_TOKENS", 60000) * CHARS_PER_TOKEN)
        started = time.monotonic()
        body, reason = summarize(cmd, extract)
        secs = round(time.monotonic() - started, 1)
        if body is not None:
            source = f"summary by {os.environ.get('CLAUDE_RESUME_GUARD_MODEL', 'haiku')}"
        elif reason == "limit":
            log(f"session {session_id} ({tokens // 1000}k tokens, idle {int(idle // 60)} min): summary call hit a "
                "usage or rate limit, resuming unchanged")
            record({**base, "action": "resume", "reason": "limit", "seconds": secs})
            return args
        elif os.environ.get("CLAUDE_RESUME_GUARD_FALLBACK", "digest") == "resume":
            log(f"session {session_id}: summary failed ({reason}), resuming unchanged")
            record({**base, "action": "resume", "reason": reason, "seconds": secs})
            return args
        else:
            log(f"session {session_id}: summary failed ({reason}), using the transcript extract")
    if body is None:
        body = digest(entries, env_int("CLAUDE_RESUME_GUARD_HANDOFF_TOKENS", 20000) * CHARS_PER_TOKEN)
        source = "mechanical extract of the transcript: user messages, replies, tools, files"
    text = handoff_text(session_id, tokens, idle, source, body)
    hpath = write_handoff(text)
    pp = pending_path(task_id)
    if pp:
        try:
            os.makedirs(os.path.dirname(pp), exist_ok=True)
            with open(pp, "w", encoding="utf-8") as f:
                f.write(text)
        except OSError:
            pass
    log(f"session {session_id} is cold ({tokens // 1000}k tokens, idle {int(idle // 60)} min): fresh session "
        f"with a hand-off ({source}, ~{len(text) // CHARS_PER_TOKEN // 1000}k tokens) instead of --resume")
    record({**base, "action": "handoff", "source": source, "handoff_tokens": len(text) // CHARS_PER_TOKEN})
    return with_handoff(args[:idx] + args[idx + count:], hpath)


def main() -> None:
    args = sys.argv[1:]
    cmd = next_command()
    try:
        new_args = guard(args, cmd)
    except Exception as e:  # never block a task on the guard itself
        log(f"internal error, running unchanged: {type(e).__name__}: {e}")
        new_args = args
    run_next(cmd, new_args)


if __name__ == "__main__":
    main()
