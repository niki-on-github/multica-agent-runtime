#!/usr/bin/env bash
# runtime-doctor: what works in this container. No tokens are printed.
#   --gpu   also run a CUDA container on the GPU (pulls nvidia/cuda base)
#   --json  versions only, as JSON
# Exit status 0, unless --strict and a check failed.
set -uo pipefail
LIB=/usr/local/lib/multica-agent-runtime
# shellcheck source=SCRIPTDIR/../lib/multica-agent-runtime/common.sh
. "$LIB/common.sh"
if [ -r "${XDG_RUNTIME_DIR:-/run/agent}/agent.env" ]; then
  # shellcheck disable=SC1091
  . "${XDG_RUNTIME_DIR:-/run/agent}/agent.env"
fi

gpu_test=0 strict=0
for a in "$@"; do
  case "$a" in
    --gpu) gpu_test=1 ;;
    --strict) strict=1 ;;
    --json) exec cat /etc/multica-agent-runtime/versions.json ;;
    -h | --help) sed -n '2,6p' "$0"; exit 0 ;;
  esac
done

failed=0
section() { printf '\n== %s\n' "$*"; }
ok() { printf '  [ok]   %s\n' "$*"; }
no() { printf '  [--]   %s\n' "$*"; }
bad() { printf '  [FAIL] %s\n' "$*"; failed=1; }
hint() { printf '         %s\n' "$*"; }

section "image"
jq -r '"  variant \(.variant), \(.multica), Claude Code \(."claude-code"), Codex \(.codex), Pi \(.pi), Oh My Pi \(.omp)"' \
  /etc/multica-agent-runtime/versions.json 2>/dev/null || bad "versions.json missing"
printf '  uid %s, HOME %s\n' "$(id -u)" "$HOME"

section "agent CLIs (one Multica runtime each)"
for c in claude codex pi omp; do
  if command -v "$c" >/dev/null; then ok "$c: $(command -v "$c")"; else no "$c not installed"; fi
done

section "logins"
if [ -s "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.credentials.json" ]; then ok "Claude Code: subscription login ($CLAUDE_CONFIG_DIR/.credentials.json)"
elif is_set CLAUDE_CODE_OAUTH_TOKEN; then ok "Claude Code: CLAUDE_CODE_OAUTH_TOKEN"
elif is_set ANTHROPIC_API_KEY; then ok "Claude Code: ANTHROPIC_API_KEY"
elif is_set ANTHROPIC_BASE_URL; then ok "Claude Code: ANTHROPIC_BASE_URL ($ANTHROPIC_BASE_URL)"
else no "Claude Code: not logged in"; hint "web shell: claude, then /login (paste the code back)"; fi
if [ -s "$HOME/.codex/auth.json" ]; then ok "Codex: login (~/.codex/auth.json)"
elif is_set OPENAI_API_KEY; then ok "Codex: OPENAI_API_KEY"
else no "Codex: not logged in"; hint "codex login --device-auth"; fi
if is_set MULTICA_TOKEN; then ok "Multica: MULTICA_TOKEN, server ${MULTICA_SERVER_URL:-default}"
else no "Multica: MULTICA_TOKEN not set (daemon waits)"; fi
if is_set GH_TOKEN; then ok "GitHub: GH_TOKEN"; elif gh auth status >/dev/null 2>&1; then ok "GitHub: gh login"; else no "GitHub: no token"; fi
if tea login list 2>/dev/null | grep -q gitea; then ok "Gitea: tea login ${GITEA_URL:-}"; else no "Gitea: no tea login (GITEA_URL + GITEA_TOKEN)"; fi
hint "MCP OAuth with a localhost callback: copy the failed redirect URL from the browser, curl '<url>' here"

section "Docker"
printf '  mode %s (DIND_MODE), DOCKER_HOST %s\n' "${DIND_ACTIVE_MODE:-unknown}" "${DOCKER_HOST:-}"
if docker info >/dev/null 2>&1; then
  ok "$(docker info --format 'server {{.ServerVersion}}, storage {{.Driver}}, cgroup {{.CgroupVersion}}, {{.SecurityOptions}}' 2>/dev/null)"
  ok "$(docker compose version 2>/dev/null), $(docker buildx version 2>/dev/null | cut -d' ' -f1-2)"
else
  no "no Docker daemon answers"
  if [ -s "${XDG_RUNTIME_DIR}/dockerd.log" ]; then hint "log: ${XDG_RUNTIME_DIR}/dockerd.log"; fi
fi
printf '  seccomp %s, AppArmor %s, no_new_privs %s, userns %s (%s ids), /proc masked %s, /dev/net/tun %s\n' \
  "$(seccomp_mode)" "$(apparmor_profile)" "$(no_new_privs)" \
  "$(in_userns && echo yes || echo no)" "$(userns_size)" \
  "$(proc_masked && echo yes || echo no)" "$([ -c /dev/net/tun ] && echo yes || echo no)"

section "task sandbox"
# shellcheck source=SCRIPTDIR/../lib/multica-agent-runtime/sandbox.sh
. "$LIB/sandbox.sh"
printf '  AGENT_SANDBOX %s, active for: %s, %s\n' "${AGENT_SANDBOX:-off}" "${AGENT_SANDBOX_ACTIVE:-none}" "$(bwrap --version 2>/dev/null)"
if out=$(sandbox_preflight); then ok "bwrap can create user, pid, ipc and uts namespaces"
elif [ "${AGENT_SANDBOX_PREFLIGHT:-}" = ok ]; then
  # e.g. the web shell's container: masked /proc, default seccomp. Tasks run in the daemon's container.
  ok "the daemon's container passed the bwrap check at start (tasks run there)"
  no "not usable in this container: $out"
elif [ "${AGENT_SANDBOX:-off}" = off ]; then no "bwrap cannot create namespaces here: $out"
else bad "bwrap cannot create namespaces here: $out"; fi
homes=${AGENT_SANDBOX_HOMES:-/data/agent-homes}
if [ -d "$homes" ]; then
  ok "per-agent homes in $homes: $(find "$homes" -mindepth 1 -maxdepth 1 -type d | wc -l) (created on an agent's first task), $(du -sh "$homes" 2>/dev/null | cut -f1)"
fi
printf '  pass-through: %s\n' "${AGENT_SANDBOX_PASS_ENV:-none}"

section "GPU"
if command -v nvidia-smi >/dev/null && nvidia-smi -L >/dev/null 2>&1; then
  nvidia-smi -L | sed 's/^/  [ok]   /'
  spec=
  for f in /etc/cdi/nvidia.yaml "$XDG_RUNTIME_DIR/cdi/nvidia.yaml"; do [ -s "$f" ] && spec=$f; done
  if [ -n "$spec" ]; then ok "CDI spec $spec"
  elif [ -n "${GPU_CDI_SPEC:-}" ] && [ "$GPU_CDI_SPEC" != failed ]; then
    ok "CDI spec $GPU_CDI_SPEC in the daemon's container (not visible in this one)"
  else bad "no CDI spec (see $XDG_RUNTIME_DIR/nvidia-cdi.log)"; fi
  if (( gpu_test )); then
    img="docker.io/nvidia/cuda:${CUDA_VERSION:-13.4.3}-base-ubuntu26.04"
    if out=$(docker run --rm --device nvidia.com/gpu=all "$img" nvidia-smi -L 2>&1); then ok "nested container sees: $out"
    else bad "nested GPU container failed:"; printf '%s\n' "$out" | tail -n 5 | sed 's/^/         /'; fi
  else
    hint "doctor --gpu runs nvidia-smi in a nested CUDA container"
  fi
elif command -v nvidia-ctk >/dev/null; then
  no "cuda image, but no GPU visible (runtimeClassName: nvidia, NVIDIA_VISIBLE_DEVICES)"
else
  no "cpu image"
fi

section "browser"
if out=$(/opt/google/chrome/chrome --version 2>&1); then ok "$out (/opt/google/chrome/chrome)"; else bad "chrome: $out"; fi
ok "playwright $(playwright --version 2>/dev/null | awk '{print $2}'), MCPs: playwright-mcp, chrome-devtools-mcp"
registered=() missing=()
for entry in "claude|${CLAUDE_CONFIG_DIR:-$HOME/.claude}/.claude.json|.mcpServers" \
  "pi|$HOME/.pi/agent/mcp.json|.mcpServers" \
  "omp|$HOME/.omp/agent/mcp.json|.mcpServers"; do
  IFS='|' read -r agent file key <<<"$entry"
  command -v "$agent" >/dev/null || continue
  if jq -e "$key | has(\"playwright\") and has(\"chrome-devtools\")" "$file" >/dev/null 2>&1; then
    registered+=("$agent")
  else missing+=("$agent"); fi
done
if command -v codex >/dev/null; then
  if grep -qE '^\[mcp_servers\.("?)playwright\1\]' "$HOME/.codex/config.toml" 2>/dev/null; then
    registered+=(codex)
  else missing+=(codex); fi
fi
[ "${#registered[@]}" -eq 0 ] || ok "browser MCPs (playwright, chrome-devtools) for: ${registered[*]}"
[ "${#missing[@]}" -eq 0 ] || no "browser MCPs not registered for: ${missing[*]} (BROWSER_MCP=${BROWSER_MCP:-1})"
shm_kb=$(df -Pk /dev/shm 2>/dev/null | awk 'NR==2 {print $2}')
printf '  /dev/shm %s MiB%s\n' "$(( ${shm_kb:-0} / 1024 ))" "$([ "${shm_kb:-0}" -lt 1048576 ] && echo ' (small: Chrome uses --disable-dev-shm-usage)')"

section "caches"
check_url() {
  local name=$1 url=$2
  local code
  # any HTTP answer counts (e.g. olah answers 404 on /): only no connection or TLS is a failure
  code=$(curl -sS -o /dev/null -w '%{http_code}' -m 5 "$url" 2>/dev/null) || code=000
  if [ "$code" != 000 ]; then ok "$name $url${code:+ (HTTP $code)}"; else bad "$name $url not reachable"; fi
}
subs=$(printf '%s\n' "${NIX_CONFIG:-}" | sed -nE 's/^[[:space:]]*extra-substituters[[:space:]]*=[[:space:]]*//p' | tr ' ' '\n' | sed '/^$/d')
if [ -n "$subs" ]; then
  while IFS= read -r s; do check_url "Nix" "${s%%\?*}/nix-cache-info"; done <<<"$subs"
else no "Nix: cache.nixos.org only (NIX_CONFIG extra-substituters)"; fi
if [ -n "${PIP_INDEX_URL:-}" ]; then check_url "pip/uv" "$PIP_INDEX_URL"; else no "pip/uv: PyPI (PIP_INDEX_URL, UV_DEFAULT_INDEX)"; fi
if [ -n "${HF_ENDPOINT:-}" ]; then check_url "Hugging Face" "$HF_ENDPOINT"; else no "Hugging Face: huggingface.co (HF_ENDPOINT)"; fi
if [ -n "${NPM_CONFIG_REGISTRY:-}" ]; then check_url "npm" "$NPM_CONFIG_REGISTRY"; else no "npm: registry.npmjs.org (NPM_CONFIG_REGISTRY)"; fi
printf '  CA bundle %s\n' "${SSL_CERT_FILE:-system default}"

section "storage"
df -h "$HOME" /data 2>/dev/null | sed 's/^/  /'

echo
if (( strict && failed )); then exit 1; fi
exit 0
