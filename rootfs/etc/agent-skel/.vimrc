" Seeded once from /etc/agent-skel; edit freely.
set nocompatible
syntax on
filetype plugin indent on
set number
set expandtab shiftwidth=2 tabstop=2 softtabstop=2
set autoindent
set incsearch hlsearch ignorecase smartcase
set backspace=indent,eol,start
set mouse=a
set encoding=utf-8
set ruler showcmd
